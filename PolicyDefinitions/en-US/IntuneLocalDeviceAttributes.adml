<policyDefinitionResources revision="1.0" schemaVersion="1.0">
  <displayName>Intune Local Device Attributes</displayName>
  <description>Configure free-form local device attributes through Microsoft Intune.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Windows10OrLater">Windows 10 or later</string>
      <string id="IntuneLocalDeviceAttributes">Intune Local Device Attributes</string>
      <string id="Attributes">Attributes</string>
      <string id="AttributeExplain">Stores a free-form text value locally on the device. The administrator defines its meaning and accepted value. The value is available under HKLM\SOFTWARE\Policies\IntuneLocalDeviceAttributes. If the policy is disabled or not configured, the corresponding registry value is removed.</string>
